{
  "name": "EvidenceBI",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "FactSales",
        "columns": [
          {
            "name": "LineID",
            "dataType": "string",
            "sourceColumn": "LineID",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "RegionKey",
            "dataType": "int64",
            "sourceColumn": "RegionKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "RevenueMinor",
            "dataType": "int64",
            "sourceColumn": "RevenueMinor",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)),",
                "    Source = Table.FromRows(Rows, {\"LineID\", \"Date\", \"RegionKey\", \"ProductKey\", \"RevenueMinor\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"LineID\", type text}, {\"Date\", type date}, {\"RegionKey\", Int64.Type}, {\"ProductKey\", Int64.Type}, {\"RevenueMinor\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "SUM('FactSales'[RevenueMinor])",
            "formatString": "#,0",
            "displayFolder": "Business KPIs"
          },
          {
            "name": "Revenue Previous Period",
            "expression": "VAR PeriodRows = CALCULATE(COUNTROWS('FactSales'), REMOVEFILTERS('DimDate'), FILTER(ALL('DimDate'), 'DimDate'[Date] >= DATE(2026, 1, 1) && 'DimDate'[Date] < DATE(2026, 2, 1)))\nVAR Amount = CALCULATE([Revenue], REMOVEFILTERS('DimDate'), FILTER(ALL('DimDate'), 'DimDate'[Date] >= DATE(2026, 1, 1) && 'DimDate'[Date] < DATE(2026, 2, 1)))\nRETURN IF(COALESCE(PeriodRows, 0) = 0, 0, Amount)",
            "formatString": "#,0",
            "displayFolder": "Business KPIs"
          },
          {
            "name": "Revenue Current Period",
            "expression": "VAR PeriodRows = CALCULATE(COUNTROWS('FactSales'), REMOVEFILTERS('DimDate'), FILTER(ALL('DimDate'), 'DimDate'[Date] >= DATE(2026, 2, 1) && 'DimDate'[Date] < DATE(2026, 3, 1)))\nVAR Amount = CALCULATE([Revenue], REMOVEFILTERS('DimDate'), FILTER(ALL('DimDate'), 'DimDate'[Date] >= DATE(2026, 2, 1) && 'DimDate'[Date] < DATE(2026, 3, 1)))\nRETURN IF(COALESCE(PeriodRows, 0) = 0, 0, Amount)",
            "formatString": "#,0",
            "displayFolder": "Business KPIs"
          },
          {
            "name": "Revenue Change",
            "expression": "VAR Previous = [Revenue Previous Period]\nVAR CurrentAmount = [Revenue Current Period]\nRETURN IF(ISBLANK(Previous) || ISBLANK(CurrentAmount), BLANK(), CurrentAmount - Previous)",
            "formatString": "#,0",
            "displayFolder": "Business KPIs"
          },
          {
            "name": "Revenue Growth %",
            "expression": "VAR Previous = [Revenue Previous Period]\nRETURN IF(Previous > 0, DIVIDE([Revenue Change], Previous), BLANK())",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Business KPIs"
          }
        ]
      },
      {
