model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["FactSales", "DimRegion", "DimProduct", "DimDate", "Evidence", "AnalysisInfo"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table FactSales
ref table DimRegion
ref table DimProduct
ref table DimDate
ref table Evidence
ref table AnalysisInfo

